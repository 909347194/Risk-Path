# 放在 manuscript3 根目录；root = false 表示继承仓库上级配置
root = false

[*.{tex,bib,sty,cls}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{Makefile,.latexmkrc}]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
