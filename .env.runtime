# ============================================================================
# Risk-Path · 运行环境变量（Qwen Coder / CI / 无显示容器通用）
# 注意：本文件只放“运行环境变量”，不含密钥。项目原有的 .env 是 cdsapi 凭证，请勿混淆。
#
# 用法（bash / Git-Bash）：
#     set -a; source .env.runtime; set +a
#     uv run python methods/spatiotemporal_heterogeneity/experiments/viz_data/viz_noise.py --save
#
# Windows PowerShell：
#     Get-Content .env.runtime | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
# ============================================================================

# ---------- 1. 渲染后端（必设）----------
# 无显示环境必须用 Agg，否则 matplotlib 的 plt.show() 会卡死 / 报 _tkinter 缺失。
# 即使脚本带 --save 不弹窗，Agg 也保证 plt 不依赖任何 GUI 库。
MPLBACKEND=Agg

# ---------- 2. 编码（Windows 上强烈建议）----------
# 保证中文路径、日志、argv 全程 UTF-8，避免 GBK 解码报错。
PYTHONUTF8=1
# 不写 __pycache__，保持工作树干净（CI 友好，可选）
PYTHONDONTWRITEBYTECODE=1

# ---------- 3. 模块导入（兜底，可注释）----------
# viz_noise.py 等脚本已自带 sys.path.insert 把 module/src 加进路径，通常无需设。
# 若用 `python -m unittest methods...` 或裸跑模块级脚本，可把项目根放到 PYTHONPATH：
# PYTHONPATH=/绝对路径/01Reproduction/Risk-Path

# ---------- 4. 网络（仅当 Qwen Coder 需代理才能访问 PyPI 时取消注释）----------
# 公司内网 / 受限容器常见。uv 与 pip 都会读取这些变量。
# HTTPS_PROXY=http://<host>:<port>
# HTTP_PROXY=http://<host>:<port>
# NO_PROXY=localhost,127.0.0.1

# ---------- 5. uv 镜像（内网有 PyPI 镜像时加速 uv sync）----------
# 取消注释并改成你的镜像地址；uv 优先读 UV_DEFAULT_INDEX。
# UV_DEFAULT_INDEX=https://<mirror>/simple
# UV_INDEX_URL=https://<mirror>/simple
